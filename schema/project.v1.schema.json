{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning-suite:schema:project:v1",
  "title": "Projet Learning Suite (v1)",
  "description": "Format d'un module e-learning : project.json + dossier media/. Source de vérité partagée par Studio, le lecteur et l'IA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "mode",
    "theme",
    "navigation",
    "scoring",
    "pages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Chemin facultatif vers ce schéma, pour l'aide à la saisie dans les éditeurs."
    },
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "description": "Version du format. 1.1 ajoute la brique html ; 1.2 les activités (cartes, onglets, texte à trous, glisser-déposer, zones). Les anciennes versions restent valides."
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "mode": {
      "enum": [
        "slides",
        "vertical"
      ],
      "description": "slides = diapositives 16:9 avec briques placées librement ; vertical = briques empilées, lecture au défilement (mobile)."
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "navigation": {
      "$ref": "#/$defs/navigation"
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      },
      "description": "Les écrans du module, dans l'ordre. On dit « page » dans les deux modes."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "slides"
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "properties": {
                "blocks": {
                  "items": {
                    "required": [
                      "frame"
                    ],
                    "not": {
                      "required": [
                        "width"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "pages": {
            "items": {
              "properties": {
                "blocks": {
                  "items": {
                    "not": {
                      "required": [
                        "frame"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Identifiant court, unique dans le projet (lettres, chiffres, - et _)."
    },
    "color": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "description": "Couleur hexadécimale : #RRGGBB ou #RRGGBBAA (transparence)."
    },
    "mediaPath": {
      "type": "string",
      "pattern": "^media/(?!.*\\.\\.)[^\\\\:*?\"<>|]+$",
      "description": "Chemin d'un fichier du dossier media/ du projet, ex. media/accueil.png."
    },
    "richText": {
      "type": "string",
      "maxLength": 5000,
      "description": "Texte en mini-Markdown : **gras**, *italique*, listes (- ou 1.), [lien](https://…), retours à la ligne. Pas de HTML."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Identifiant unique du module (UUID), créé une fois pour toutes."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "description": "Langue du contenu : fr, en, fr-CA…"
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Version du module, ex. 1.0.0."
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "fonts"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "background",
            "text"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/color",
              "description": "Couleur principale : boutons, titres, barre de progression."
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color",
              "description": "Mise en avant ponctuelle."
            },
            "background": {
              "$ref": "#/$defs/color",
              "description": "Fond des pages."
            },
            "surface": {
              "$ref": "#/$defs/color",
              "description": "Fond des cartes, questions, menus."
            },
            "text": {
              "$ref": "#/$defs/color"
            },
            "success": {
              "$ref": "#/$defs/color",
              "description": "Bonne réponse, module réussi."
            },
            "error": {
              "$ref": "#/$defs/color",
              "description": "Mauvaise réponse, module échoué."
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "body"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "maxLength": 100,
              "description": "Police des titres, ex. « Inter »."
            },
            "body": {
              "type": "string",
              "maxLength": 100,
              "description": "Police du texte courant."
            }
          }
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 8,
          "description": "Arrondi des angles (boutons, cartes), en pixels."
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linear": {
          "type": "boolean",
          "default": false,
          "description": "Vrai = le menu ne permet pas de sauter vers une page pas encore vue."
        },
        "allowBack": {
          "type": "boolean",
          "default": true,
          "description": "Bouton « Précédent » visible."
        },
        "showMenu": {
          "type": "boolean",
          "default": true,
          "description": "Menu des pages visible."
        },
        "showProgress": {
          "type": "boolean",
          "default": true,
          "description": "Barre de progression visible."
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passingScore"
      ],
      "properties": {
        "passingScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Seuil de réussite en %, calculé sur les points des questions notées (graded)."
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Titre affiché dans le menu."
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "image": {
              "$ref": "#/$defs/mediaPath"
            }
          }
        },
        "voiceover": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src"
          ],
          "description": "Voix off de la page : un fichier audio + sa transcription (accessibilité).",
          "properties": {
            "src": {
              "$ref": "#/$defs/mediaPath"
            },
            "transcript": {
              "type": "string",
              "maxLength": 10000
            },
            "autoplay": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "unlockNext": {
          "enum": [
            "always",
            "voiceoverEnded",
            "questionsAnswered",
            "activitiesDone"
          ],
          "default": "always",
          "description": "Quand « Suivant » se débloque. activitiesDone (= questionsAnswered) : toutes les activités de la page sont terminées."
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "description": "Briques de la page. En mode slides, l'ordre sert aussi de superposition (la dernière est au-dessus)."
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "description": "Position et taille sur la toile 1280 × 720 (mode slides seulement). Le lecteur met à l'échelle de l'écran.",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1280,
          "maximum": 2560
        },
        "y": {
          "type": "number",
          "minimum": -720,
          "maximum": 1440
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2560
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1440
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "default": 0
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Surcharges ponctuelles du thème pour une brique.",
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 200
        },
        "bold": {
          "type": "boolean"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "verticalAlign": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 999
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "blockBase": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "width": {
          "enum": [
            "full",
            "content"
          ],
          "default": "content",
          "description": "Mode vertical seulement : full = bord à bord, content = colonne de lecture."
        },
        "style": {
          "$ref": "#/$defs/style"
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "image",
            "shape",
            "button",
            "video",
            "audio",
            "question",
            "results",
            "html",
            "flipcards",
            "reveal",
            "fillblanks",
            "dragdrop",
            "hotspot"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/textBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/imageBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shape"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/shapeBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/buttonBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/videoBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "audio"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/audioBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "question"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/questionBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "results"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/resultsBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/htmlBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "flipcards"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/flipcardsBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reveal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/revealBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fillblanks"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/fillblanksBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dragdrop"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/dragdropBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hotspot"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/hotspotBlock"
          }
        }
      ]
    },
    "textBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "variant": {
          "enum": [
            "title",
            "subtitle",
            "body",
            "caption"
          ],
          "default": "body",
          "description": "Style de base tiré du thème."
        },
        "content": {
          "$ref": "#/$defs/richText"
        }
      }
    },
    "imageBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "src": {
          "$ref": "#/$defs/mediaPath"
        },
        "alt": {
          "type": "string",
          "maxLength": 500,
          "description": "Description pour les lecteurs d'écran. Chaîne vide = image décorative."
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ],
          "default": "contain"
        }
      }
    },
    "shapeBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "shape"
      ],
      "properties": {
        "type": {
          "const": "shape"
        },
        "shape": {
          "enum": [
            "rectangle",
            "ellipse",
            "line"
          ]
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 0
        }
      }
    },
    "buttonBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "label",
        "action"
      ],
      "properties": {
        "type": {
          "const": "button"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "variant": {
          "enum": [
            "primary",
            "secondary"
          ],
          "default": "primary"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "next",
                    "prev"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "page"
              ],
              "properties": {
                "type": {
                  "const": "goto"
                },
                "page": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "href"
              ],
              "properties": {
                "type": {
                  "const": "url"
                },
                "href": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          ]
        }
      }
    },
    "videoBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "type": {
          "const": "video"
        },
        "src": {
          "$ref": "#/$defs/mediaPath",
          "description": "Fichier MP4 (H.264) recommandé."
        },
        "poster": {
          "$ref": "#/$defs/mediaPath",
          "description": "Image affichée avant la lecture."
        },
        "captions": {
          "$ref": "#/$defs/mediaPath",
          "description": "Sous-titres au format WebVTT (.vtt)."
        },
        "autoplay": {
          "type": "boolean",
          "default": false
        },
        "loop": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "audioBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "type": {
          "const": "audio"
        },
        "src": {
          "$ref": "#/$defs/mediaPath",
          "description": "Fichier MP3 recommandé."
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "transcript": {
          "type": "string",
          "maxLength": 10000
        },
        "autoplay": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "correct"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "correct": {
          "type": "boolean"
        }
      }
    },
    "questionBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "kind",
        "prompt"
      ],
      "properties": {
        "type": {
          "const": "question"
        },
        "kind": {
          "enum": [
            "single",
            "multiple",
            "truefalse"
          ],
          "description": "Choix unique, choix multiple ou vrai/faux."
        },
        "prompt": {
          "$ref": "#/$defs/richText",
          "description": "L'énoncé de la question."
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "answer": {
          "type": "boolean",
          "description": "Vrai/faux seulement : la bonne réponse."
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correct": {
              "$ref": "#/$defs/richText"
            },
            "incorrect": {
              "$ref": "#/$defs/richText"
            }
          }
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1,
          "description": "Nombre d'essais autorisés."
        },
        "shuffle": {
          "type": "boolean",
          "default": false,
          "description": "Mélanger l'ordre des choix."
        },
        "points": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "graded": {
          "type": "boolean",
          "default": true,
          "description": "Compte dans le score final (faux = question d'entraînement)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "truefalse"
              }
            }
          },
          "then": {
            "required": [
              "answer"
            ],
            "not": {
              "required": [
                "choices"
              ]
            }
          },
          "else": {
            "required": [
              "choices"
            ],
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "single"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "contains": {
                  "properties": {
                    "correct": {
                      "const": true
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multiple"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "contains": {
                  "properties": {
                    "correct": {
                      "const": true
                    }
                  }
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "resultsBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "description": "Affiche le score, le seuil et « Réussi » ou « Échoué ».",
      "properties": {
        "type": {
          "const": "results"
        },
        "passedMessage": {
          "$ref": "#/$defs/richText"
        },
        "failedMessage": {
          "$ref": "#/$defs/richText"
        },
        "allowRetry": {
          "type": "boolean",
          "default": true,
          "description": "Bouton « Recommencer le quiz » en cas d'échec."
        }
      }
    },
    "htmlBlock": {
      "$ref": "#/$defs/blockBase",
      "unevaluatedProperties": false,
      "required": [
        "src",
        "title"
      ],
      "description": "Page HTML (jeu, simulation…) affichée dans un cadre isolé. Elle peut renvoyer un score avec LearningSuite.score(0-100).",
      "properties": {
        "type": {
          "const": "html"
        },
        "src": {
          "allOf": [
            {
              "$ref": "#/$defs/mediaPath"
            },
            {
              "pattern": "\\.html?$"
            }
          ],
          "description": "Fichier HTML du dossier media/, ex. media/jeux/memory.html."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Nom de l'activité, lu par les lecteurs d'écran."
        },
        "graded": {
          "type": "boolean",
          "default": false,
          "description": "Compte dans le score final. Le jeu doit alors appeler LearningSuite.score()."
        },
        "points": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1,
          "description": "Points de l'activité ; le jeu en obtient une part selon son score (80 % de 2 points = 1,6)."
        },
        "height": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4000,
          "default": 600,
          "description": "Hauteur en pixels en mode vertical (en mode diapositives, c'est le frame qui compte)."
        }
      }
    },
    "gradedProps": {
      "type": "object",
      "description": "Réglages des activités notées à plusieurs éléments.",
      "properties": {
        "graded": {
          "type": "boolean",
          "default": true,
          "description": "Compte dans le score final."
        },
        "points": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1,
          "description": "Nombre d'essais."
        },
        "scoring": {
          "enum": [
            "partial",
            "all-or-nothing"
          ],
          "default": "partial",
          "description": "partial : points au prorata (3 sur 4 = 75 %) ; all-or-nothing : 0 point s'il y a une erreur."
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correct": {
              "$ref": "#/$defs/richText"
            },
            "partial": {
              "$ref": "#/$defs/richText",
              "description": "Message si une partie seulement est juste."
            },
            "incorrect": {
              "$ref": "#/$defs/richText"
            }
          }
        }
      }
    },
    "flipcardsBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "cards"
      ],
      "description": "Cartes à retourner (recto / verso).",
      "properties": {
        "type": {
          "const": "flipcards"
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "anyOf": [
              {
                "required": [
                  "front"
                ]
              },
              {
                "required": [
                  "frontImage"
                ]
              }
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "front": {
                "$ref": "#/$defs/richText",
                "description": "Recto : texte."
              },
              "frontImage": {
                "$ref": "#/$defs/mediaPath",
                "description": "Recto : image."
              },
              "back": {
                "$ref": "#/$defs/richText",
                "description": "Verso : texte."
              },
              "backImage": {
                "$ref": "#/$defs/mediaPath"
              },
              "alt": {
                "type": "string",
                "maxLength": 500,
                "description": "Description des images."
              }
            }
          }
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Nombre de colonnes (automatique si absent)."
        },
        "requireAll": {
          "type": "boolean",
          "default": false,
          "description": "Il faut retourner toutes les cartes pour terminer."
        }
      }
    },
    "revealBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "layout",
        "items"
      ],
      "description": "Contenu à découvrir : onglets, accordéon ou frise.",
      "properties": {
        "type": {
          "const": "reveal"
        },
        "layout": {
          "enum": [
            "tabs",
            "accordion",
            "timeline"
          ],
          "description": "Onglets, accordéon ou frise chronologique."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Titre de l'onglet, de la section ou de l'étape (ex. une date)."
              },
              "content": {
                "$ref": "#/$defs/richText"
              },
              "image": {
                "$ref": "#/$defs/mediaPath"
              },
              "alt": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "requireAll": {
          "type": "boolean",
          "default": false,
          "description": "Il faut tout ouvrir pour terminer."
        }
      }
    },
    "fillblanksBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "$ref": "#/$defs/gradedProps"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "text"
      ],
      "description": "Texte à trous (saisie ou liste).",
      "properties": {
        "type": {
          "const": "fillblanks"
        },
        "prompt": {
          "$ref": "#/$defs/richText",
          "description": "Consigne."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "\\[\\[[^\\]]+\\]\\]",
          "description": "Texte avec trous : [[mange|dévore]] = à saisir (plusieurs réponses acceptées) ; [[*mange|dort]] = liste, l'étoile marque la bonne réponse."
        },
        "caseSensitive": {
          "type": "boolean",
          "default": false,
          "description": "Distinguer majuscules et minuscules."
        },
        "accentSensitive": {
          "type": "boolean",
          "default": false,
          "description": "Exiger les accents."
        }
      }
    },
    "dragdropBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "$ref": "#/$defs/gradedProps"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "kind"
      ],
      "description": "Glisser-déposer (au doigt, à la souris ou au clavier).",
      "properties": {
        "type": {
          "const": "dragdrop"
        },
        "kind": {
          "enum": [
            "categorize",
            "match",
            "order"
          ],
          "description": "Ranger dans des catégories, relier des paires, ou remettre dans l'ordre."
        },
        "prompt": {
          "$ref": "#/$defs/richText",
          "description": "Consigne."
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "image": {
                "$ref": "#/$defs/mediaPath"
              },
              "alt": {
                "type": "string",
                "maxLength": 500
              },
              "category": {
                "$ref": "#/$defs/id",
                "description": "categorize : identifiant de la bonne catégorie."
              }
            }
          },
          "description": "categorize : éléments à ranger ; order : éléments DANS LE BON ORDRE (ils seront mélangés)."
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "answer"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "categorize"
            }
          },
          "required": [
            "categories",
            "items"
          ],
          "not": {
            "required": [
              "pairs"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "match"
            }
          },
          "required": [
            "pairs"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "items"
                ]
              },
              {
                "required": [
                  "categories"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "order"
            }
          },
          "required": [
            "items"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "pairs"
                ]
              },
              {
                "required": [
                  "categories"
                ]
              }
            ]
          }
        }
      ]
    },
    "hotspotBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "$ref": "#/$defs/gradedProps"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "kind",
        "src",
        "alt",
        "zones"
      ],
      "description": "Image avec zones cliquables.",
      "properties": {
        "type": {
          "const": "hotspot"
        },
        "kind": {
          "enum": [
            "find",
            "explore"
          ],
          "description": "find : cliquer les bonnes zones (noté) ; explore : cliquer pour découvrir une information."
        },
        "prompt": {
          "$ref": "#/$defs/richText",
          "description": "Consigne."
        },
        "src": {
          "$ref": "#/$defs/mediaPath"
        },
        "alt": {
          "type": "string",
          "maxLength": 500
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "x",
              "y",
              "w",
              "h",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "shape": {
                "enum": [
                  "rectangle",
                  "ellipse"
                ],
                "default": "rectangle"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Position en % de la largeur de l'image."
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Position en % de la hauteur."
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Nom de la zone (lu par les lecteurs d'écran)."
              },
              "correct": {
                "type": "boolean",
                "description": "find : zone à trouver."
              },
              "content": {
                "$ref": "#/$defs/richText",
                "description": "explore : information affichée au clic."
              }
            }
          }
        },
        "requireAll": {
          "type": "boolean",
          "default": false,
          "description": "explore : il faut ouvrir toutes les zones."
        }
      }
    }
  }
}
