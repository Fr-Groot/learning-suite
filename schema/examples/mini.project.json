{
  "$schema": "../project.v1.schema.json",
  "schemaVersion": "1.0",
  "meta": {
    "id": "3f2a9c1e-7b4d-4e8a-9c2f-1a2b3c4d5e6f",
    "title": "Mini-module de démonstration",
    "description": "Deux pages : une diapo de contenu et une question.",
    "language": "fr",
    "author": "Learning Suite",
    "version": "1.0.0",
    "estimatedMinutes": 2
  },
  "mode": "slides",
  "theme": {
    "colors": {
      "primary": "#2F5BEA",
      "secondary": "#1B2A4A",
      "accent": "#FFB020",
      "background": "#FFFFFF",
      "surface": "#F3F5FA",
      "text": "#1B2A4A",
      "success": "#1E9E5A",
      "error": "#D64545"
    },
    "fonts": { "heading": "Inter", "body": "Inter" },
    "radius": 8
  },
  "navigation": { "linear": true, "allowBack": true, "showMenu": true, "showProgress": true },
  "scoring": { "passingScore": 70 },
  "pages": [
    {
      "id": "accueil",
      "title": "Bienvenue",
      "voiceover": {
        "src": "media/accueil.mp3",
        "transcript": "Bienvenue dans ce mini-module.",
        "autoplay": true
      },
      "unlockNext": "voiceoverEnded",
      "blocks": [
        { "id": "titre", "type": "text", "variant": "title", "content": "Bienvenue",
          "frame": { "x": 80, "y": 80, "w": 1120, "h": 100 } },
        { "id": "intro", "type": "text", "content": "Ce module dure **2 minutes**.\n- une page de contenu\n- une question",
          "frame": { "x": 80, "y": 200, "w": 640, "h": 200 } },
        { "id": "illustration", "type": "image", "src": "media/accueil.svg", "alt": "Une personne devant un écran",
          "frame": { "x": 760, "y": 180, "w": 440, "h": 360 } },
        { "id": "suivant", "type": "button", "label": "Commencer", "action": { "type": "next" },
          "frame": { "x": 80, "y": 560, "w": 220, "h": 64 } }
      ]
    },
    {
      "id": "quiz",
      "title": "Question",
      "unlockNext": "questionsAnswered",
      "blocks": [
        { "id": "q1", "type": "question", "kind": "single",
          "prompt": "Quel format sert à diffuser un module dans un LMS ?",
          "choices": [
            { "id": "a", "text": "SCORM", "correct": true },
            { "id": "b", "text": "PDF", "correct": false },
            { "id": "c", "text": "MP3", "correct": false }
          ],
          "feedback": { "correct": "Exact !", "incorrect": "Non : c'est SCORM." },
          "attempts": 2,
          "frame": { "x": 80, "y": 60, "w": 1120, "h": 420 } },
        { "id": "q2", "type": "question", "kind": "truefalse",
          "prompt": "Un module SCORM peut contenir une vidéo.", "answer": true,
          "frame": { "x": 80, "y": 500, "w": 700, "h": 180 } },
        { "id": "resultat", "type": "results",
          "passedMessage": "Bravo, module réussi.", "failedMessage": "Pas encore : relisez puis réessayez.",
          "frame": { "x": 820, "y": 500, "w": 380, "h": 180 } }
      ]
    }
  ]
}
