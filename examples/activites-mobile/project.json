          "id": "frise-contenu",
          "type": "reveal",
          "layout": "timeline",
          "items": [
            {
              "id": "e1",
              "title": "0 min",
              "content": "**Débranchez le réseau** (câble ou Wi-Fi) sans éteindre l'ordinateur."
            },
            {
              "id": "e2",
              "title": "5 min",
              "content": "**Prévenez** le service informatique ou votre référent sécurité."
            },
            {
              "id": "e3",
              "title": "15 min",
              "content": "**Notez** ce que vous avez vu : message, heure, pièce jointe ouverte."
            },
            {
              "id": "e4",
              "title": "1 h",
              "content": "**Changez vos mots de passe** depuis un autre appareil sûr."
            }
          ]
        }
      ]
    },
