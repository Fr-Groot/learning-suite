            {
              "id": "f2",
              "title": "Faut-il un mot de passe différent par site ?",
              "content": "Oui. Un gestionnaire de mots de passe vous aide à les retenir."
            },
            {
              "id": "f3",
              "title": "Que faire d'un mail douteux ?",
              "content": "Ne cliquez pas, ne répondez pas : signalez-le au service informatique."
            }
